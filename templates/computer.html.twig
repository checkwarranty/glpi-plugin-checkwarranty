<div class="card p-3">
  <h2>{{ __('Hardware Warranty Status', 'checkwarranty') }}</h2>
  <p>{{ __('Serial Number', 'checkwarranty') }}: <strong>{{ computer.serial }}</strong></p>
  <p>{{ __('Scan status', 'checkwarranty') }}: {{ state }}</p>
  {% if result %}
    <dl>
      <dt>{{ __('Warranty Expiration Date', 'checkwarranty') }}</dt><dd>{{ result.warranty.endDate ?: __('Not recorded', 'checkwarranty') }}</dd>
      <dt>{{ __('Warranty start date', 'checkwarranty') }}</dt><dd>{{ result.warranty.startDate ?: __('Not recorded', 'checkwarranty') }} {{ result.warranty.startDateSource|default('') }}</dd>
      <dt>{{ __('Support Tier & Factory Specs', 'checkwarranty') }}</dt><dd>{{ result.warranty.coverageType }}</dd>
      {% for name, value in result.specs %}<dt>{{ name }}</dt><dd>{{ value }}</dd>{% endfor %}
    </dl>
  {% else %}<p>{{ __('No useful device data recorded yet.', 'checkwarranty') }}</p>{% endif %}
  {% if can_refresh and computer.serial %}
    <form method="post" action="{{ action }}">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
      <input type="hidden" name="computer_id" value="{{ computer.id }}">
      <button class="btn btn-primary" name="check_single" value="1">{{ __('Check / Refresh Warranty with CheckWarranty', 'checkwarranty') }}</button>
      <p>{{ __('Live lookups may consume API credits. Use a sandbox key for testing.', 'checkwarranty') }}</p>
    </form>
  {% endif %}
</div>
